{
  "name": "unkernel",
  "version": "0.2.0",
  "description": "Android on unkernel: experimental AArch64 Android userspace and framework bring-up",
  "license": "MIT AND GPL-2.0-only",
  "author": "Pooya Parsa <pooya@pi0.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pithings/unkernel.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "node": {
        "types": "./dist/node.d.mts",
        "default": "./dist/node.mjs"
      },
      "default": {
        "types": "./dist/web.d.mts",
        "default": "./dist/web.mjs"
      }
    },
    "./node": {
      "types": "./dist/node.d.mts",
      "default": "./dist/node.mjs"
    },
    "./web": {
      "types": "./dist/web.d.mts",
      "default": "./dist/web.mjs"
    },
    "./unkernel.wasm": "./dist/unkernel.wasm",
    "./virgl.mjs": "./dist/virgl.mjs",
    "./virgl.wasm": "./dist/virgl.wasm",
    "./kwvk-naga.wasm": "./dist/kwvk-naga.wasm",
    "./package.json": "./package.json"
  },
  "types": "./dist/node.d.mts",
  "bin": {
    "unkernel": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE-MIT",
    "THIRD-PARTY.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "obuild",
    "typecheck": "tsc -p .",
    "test": "bun run typecheck && bun run test:block && bun run test:net && bun run test:tty && bun run test:http && bun run test:ws && bun run test:9p && bun run test:distro && bun run test:gl-gpu && bun run test:vk && bun run test:va && bun run test:audio",
    "test:block": "node --test test/block.test.ts",
    "test:net": "node --test test/net.test.ts",
    "test:tty": "node --test test/tty.test.ts",
    "test:9p": "node --test test/9p.test.ts",
    "test:http": "node --test test/http.test.ts",
    "test:ws": "node --test test/ws.test.ts",
    "test:kpatch": "node --test test/kpatch.test.ts",
    "test:profile": "node --test test/profile.test.ts",
    "test:wasi": "node test/wasi-node.ts",
    "test:api": "node --test test/api.test.ts",
    "test:distro": "node --test test/distro.test.ts",
    "test:gl-gpu": "node --test test/gl-gpu.test.ts",
    "test:vk": "node --test test/vk.test.ts",
    "test:va": "node --test test/va.test.ts test/va-h264.test.ts test/va-decoders.test.ts test/va-av1.test.ts test/va-frames.test.ts test/va-enc.test.ts",
    "test:audio": "node --test test/audio.test.ts",
    "unkernel": "node js/cli.ts",
    "android:prepare": "bash guest/android/prepare.sh",
    "android:probe": "node guest/android/probe.ts",
    "android:check": "node guest/android/probe.ts --require-framework",
    "test:android": "node --test test/android.test.ts",
    "build:pages": "bun run build && bun scripts/build-pages.ts",
    "check:pages": "tsc -p pages/tsconfig.json && tsc -p scripts/tsconfig.json",
    "test:pages": "node --test test/android-pages.test.ts",
    "preview:pages": "bun scripts/serve-pages.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@types/node": "^24.19.2",
    "coi-serviceworker": "^0.1.7",
    "fzstd": "0.1.1",
    "obuild": "^0.4.45",
    "typescript": "^7.0.2",
    "wland": "0.1.0-261122-6617578"
  },
  "packageManager": "bun@1.4.4",
  "private": true
}
